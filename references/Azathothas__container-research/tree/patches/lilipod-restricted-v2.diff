+// Package sandbox probes, once and in disposable children, what the current
+// runtime actually permits. It follows the probe protocol of the container-research
+// corpus (verification/README.md):
+//
+//   - probe the operation you need, never the privilege that usually implies it
+//   - run every probe in a disposable child (a success must not mutate the prober)
+//   - record the verdict and use it; never infer one probe from another
+//
+// lilipod's restricted mode needs two facts:
+//
+//   - MountAvailable: can a child that holds a fresh mount namespace (obtained by
+//     clone(2), which this class of runtimes permits even while unshare(2) is
+//     denied) perform a mount in it? If not, lilipod's pivot_root + bind-mount
+//     container setup is impossible and the plain-chroot fallback is used.
+//   - UTSAvailable: can a child in a fresh UTS namespace set its hostname? If so,
+//     container hostnames work even in restricted mode.
+//
+// Both probes re-exec this binary; the marker arguments below are internal.
+package sandbox
+
+import (
+	"os"
+	"os/exec"
+	"sync"
+	"syscall"
+
+	"github.com/89luca89/lilipod/pkg/logging"
+)
+
+var (
+	once          sync.Once
+	mountOK       bool
+	utsOK         bool
+	restrictedVal bool
+)
+
+// mountProbeChild is executed in the disposable child: it already holds a new
+// mount namespace (spawned with CLONE_NEWNS); try to mount a tmpfs.
+func mountProbeChild() {
+	dir, err := os.MkdirTemp("", "lilipod-mountprobe")
+	if err != nil {
+		os.Exit(3)
+	}
+
+	err = syscall.Mount("none", dir, "tmpfs", 0, "")
+	if err != nil {
+		_ = syscall.Unmount(dir, syscall.MNT_DETACH)
+		os.Exit(1)
+	}
+
+	_ = syscall.Unmount(dir, syscall.MNT_DETACH)
+	os.Exit(0)
+}
+
+// utsProbeChild is executed in the disposable child: it already holds a new UTS
+// namespace (spawned with CLONE_NEWUTS); try to set the hostname.
+func utsProbeChild() {
+	err := syscall.Sethostname([]byte("lilipod-probe"))
+	if err != nil {
+		os.Exit(1)
+	}
+
+	os.Exit(0)
+}
+
+// init intercepts the internal marker arguments before cobra (or anything
+// else in main) can reject them: the probe children re-exec this very binary.
+func init() {
+	if len(os.Args) > 2 && os.Args[1] == "sandbox-probe" {
+		switch os.Args[2] {
+		case "mount":
+			mountProbeChild()
+		case "uts":
+			utsProbeChild()
+		}
+
+		os.Exit(2)
+	}
+}
+
+func probe() {
+	once.Do(func() {
+		if os.Getuid() != 0 {
+			// unprivileged users keep lilipod's rootless-helper path.
+			return
+		}
+
+		mountOK = probeSpawn(syscall.CLONE_NEWNS, "mount") == nil
+		utsOK = probeSpawn(syscall.CLONE_NEWUTS, "uts") == nil
+
+		restrictedVal = !mountOK
+
+		if restrictedVal {
+			logging.LogWarning(
+				"restricted runtime detected: mount unavailable even in a private mount namespace (unshare/clone probe); falling back to plain chroot")
+		}
+	})
+}
+
+// probeSpawn re-execs this binary in a child created with the given clone flags.
+// The child exits non-zero if the operation under test fails, so cmd.Run()'s
+// error is the verdict. The child is disposable: neither its namespace nor its
+// hostname change can leak back into this process.
+func probeSpawn(flags uintptr, what string) error {
+	cmd := exec.Command(os.Args[0], "sandbox-probe", what)
+	cmd.SysProcAttr = &syscall.SysProcAttr{Cloneflags: flags}
+
+	return cmd.Run()
+}
+
+// MountAvailable reports whether mount(2) works inside a fresh mount namespace
+// obtained through clone(2). Probed once in a disposable child.
+func MountAvailable() bool {
+	probe()
+
+	return mountOK
+}
+
+// UTSAvailable reports whether sethostname(2) works inside a fresh UTS namespace
+// obtained through clone(2). Probed once in a disposable child.
+func UTSAvailable() bool {
+	probe()
+
+	return utsOK
+}
+
+// Restricted reports whether lilipod's namespace-and-mount container setup is
+// impossible here and the plain-chroot fallback must be used.
+func Restricted() bool {
+	probe()
+
+	return restrictedVal
+}
+
+// SpawnFlags returns the clone flags lilipod should use for its container
+// processes in the current runtime. In restricted mode only capabilities that
+// were positively probed are kept (currently CLONE_NEWUTS for hostnames).
+func SpawnFlags() uintptr {
+	if !Restricted() {
+		return syscall.CLONE_NEWUTS | syscall.CLONE_NEWNS
+	}
+
+	if UTSAvailable() {
+		return syscall.CLONE_NEWUTS
+	}
+
+	return 0
+}
