+// ApplyOCIWhiteouts interprets OCI layer whiteout markers (".wh.<name>")
+// inside dir: each marker deletes the sibling entry it names, then the marker
+// itself is removed. ".wh..wh..opq" (opaque dir) markers are removed with a
+// warning: with sequential extraction into one tree there is no lower layer
+// to hide, so opaque semantics cannot apply.
+//
+// Without this, images that delete a path in a later layer (eg voidlinux
+// deleting a self-referential /var/cache/xbps symlink shipped in an earlier
+// one) keep the deleted entry, and literal ".wh.*" files leak into the rootfs.
+func ApplyOCIWhiteouts(dir string) error {
+	return filepath.Walk(dir, func(path string, info os.FileInfo, err error) error {
+		if err != nil {
+			return nil // best effort
+		}
+
+		name := info.Name()
+		if !strings.HasPrefix(name, ".wh.") {
+			return nil
+		}
+
+		if name == ".wh..wh..opq" {
+			logging.LogWarning("whiteout: opaque marker %s ignored (sequential extraction)", path)
+			_ = os.Remove(path)
+			return nil
+		}
+
+		target := filepath.Join(filepath.Dir(path), strings.TrimPrefix(name, ".wh."))
+		if err := os.RemoveAll(target); err != nil {
+			logging.LogWarning("whiteout: could not remove %s: %v", target, err)
+		}
+		_ = os.Remove(path)
+		logging.LogDebug("whiteout: applied %s -> removed %s", name, target)
+		return nil
+	})
+}
