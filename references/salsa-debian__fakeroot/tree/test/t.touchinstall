#!/bin/sh
. ./defs || exit 1

# touch and ls are immune to fakeroot on macOS
skip_if_darwin

mkdir $tmp
# fakeroot mangles spaces unless the getopt utility is the GNU version
echo "touch $tmp/iamnotuser; ls -al $tmp/iamnotuser" > $tmp/sh
run_fakeroot -- \
 ${posixshell} $tmp/sh >$tmp/out
cat $tmp/out
grep root $tmp/out
