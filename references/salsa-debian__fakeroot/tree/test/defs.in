#                                          -*- shell-script -*-

me=`basename $0`
tmp=$me.dir
rm -rf $tmp
trap 'rm -rf $tmp' EXIT

# The name of LD_PRELOAD on this platform.
LDPRELOADVAR=@LDPRELOADVAR@

case $VERBOSE in
  x)  set -x;;                # Debug mode.
  '') exec >/dev/null 2>&1;;  # By default, be silent.
esac

run_fakeroot ()
{
  tmp="$tmp"                                    \
  $PWD/../scripts/@FAKEROOT_SCRIPT@${tcp}       \
      -f $PWD/../@FAKED_BIN@${tcp}              \
      -l $PWD/../@LT_OBJDIR@/${libfakeroot}     \
       "$@"
}

# macOS apparently strips DYLD_INSERT_LIBRARIES before
# executing any platform-signed binary, so fakeroot
# cannot work on them.
#
# Unless someone can offer a better check for this, the
# following function is meant to help skip tests which
# call such binaries on "Darwin"
skip_if_darwin ()
{
  case "$(uname -s)" in
    Darwin) exit 77;;
  esac
}
